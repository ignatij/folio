# Pianist Folio site configuration.
# This repository deploys the file as /etc/caddy/sites/folio-pianist.caddy.
# The host-level /etc/caddy/Caddyfile must import /etc/caddy/sites/*.caddy.
#
# Required: the `folio` service must be running and /etc/folio.env must set:
#   PORT=8082
#   UPLOAD_DIR=/opt/folio/uploads
#   DB_PATH=/opt/folio/data/blog.db
#   SITE_BUILD_SCRIPT=/opt/folio/site/build.sh
#   SITE_DIST=/opt/folio/site/dist
#   BACKEND_URL=http://localhost:8082

# Redirect www → apex
www.anastasijagichevska.com {
    redir https://anastasijagichevska.com{uri} permanent
}

anastasijagichevska.com {
    # ── API: proxy to Go backend ──────────────────────────────────────────
    handle /api/* {
        reverse_proxy localhost:8082
    }

    # ── Admin UI: proxy to Go backend ────────────────────────────────────
    handle /admin* {
        reverse_proxy localhost:8082
    }

    # ── Uploads: served directly by Caddy (no backend hop) ───────────────
    handle /uploads/* {
        root * /opt/folio
        file_server
    }

    # ── Static site: served directly by Caddy ────────────────────────────
    handle {
        root * /opt/folio/site/dist
        try_files {path} {path}/index.html =404
        file_server
    }

    # ── Gzip compression ──────────────────────────────────────────────────
    encode gzip

    # ── Security headers ──────────────────────────────────────────────────
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}
