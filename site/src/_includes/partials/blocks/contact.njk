{%- set cc = b.config -%}
{%- set formId = b.id or "home-contact" -%}
{%- if _inContainer -%}
<div class="reference-contact-section w-full"{% if cc.elementId %} id="{{ cc.elementId }}"{% endif %}{% if cc.customStyle %} style="{{ cc.customStyle }}"{% endif %}>
{%- else -%}
<section class="reference-section"{% if cc.elementId %} id="{{ cc.elementId }}"{% endif %}{% if cc.customStyle %} style="{{ cc.customStyle }}"{% endif %}>
  <div class="reference-contact-section">
{%- endif -%}
    <div class="reference-contact-grid">
      <div class="reference-contact-copy">
        <div class="space-y-2">
          <p class="reference-eyebrow">{{ cc.eyebrow or "Contact" }}</p>
          <h2 class="reference-section-title">{{ cc.title }}</h2>
        </div>
        {% if cc.intro %}
          <p class="text-sm leading-relaxed text-[#3d3d3d]">{{ cc.intro }}</p>
        {% endif %}
        {% if cc.socialLinks and cc.socialLinks.length %}
          <div class="reference-social-links">
            {% for link in cc.socialLinks %}
              <a class="reference-social-link" href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ link.label }}</a>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div>
        <div id="{{ formId }}-success" class="reference-contact-status reference-contact-success hidden" role="status">
          {{ cc.successMessage or "Thank you for your message — we'll be in touch soon!" }}
        </div>
        <form class="reference-contact-form" action="/api/v1/contact" method="POST"
              data-contact-form data-success-id="{{ formId }}-success" data-error-id="{{ formId }}-error"
              data-error="{{ cc.errorMessage or 'Something went wrong. Please try again.' }}">
          <div class="reference-contact-field">
            <label class="reference-contact-label" for="{{ formId }}-name">{{ cc.nameLabel or "Full Name" }}</label>
            <input class="reference-contact-input" id="{{ formId }}-name" type="text" name="first_name" autocomplete="name" placeholder="{{ cc.namePlaceholder or 'Full Name' }}" required>
          </div>
          <div class="reference-contact-field">
            <label class="reference-contact-label" for="{{ formId }}-email">{{ cc.emailLabel or "Email" }}</label>
            <input class="reference-contact-input" id="{{ formId }}-email" type="email" name="email" autocomplete="email" placeholder="{{ cc.emailPlaceholder or 'Email' }}" required>
          </div>
          <div class="reference-contact-field">
            <label class="reference-contact-label" for="{{ formId }}-message">{{ cc.messageLabel or "Message" }}</label>
            <textarea class="reference-contact-input reference-contact-textarea" id="{{ formId }}-message" name="message" placeholder="{{ cc.messagePlaceholder or 'Message' }}" required></textarea>
          </div>
          <div class="contact-honeypot" aria-hidden="true" style="position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden">
            <label for="{{ formId }}-website">Website</label>
            <input id="{{ formId }}-website" type="text" name="website" tabindex="-1" autocomplete="off">
          </div>
          {% if config.turnstileSiteKey %}
            <div class="cf-turnstile" data-sitekey="{{ config.turnstileSiteKey }}" data-action="contact" data-size="flexible"
                 data-callback="folioTurnstileSuccess" data-error-callback="folioTurnstileError"
                 data-expired-callback="folioTurnstileExpired" data-refresh-expired="auto"></div>
          {% endif %}
          <div id="{{ formId }}-error" class="reference-contact-status reference-contact-error hidden" role="alert"></div>
          <button class="reference-contact-submit" type="submit">{{ cc.submitLabel or "Send Message" }}</button>
        </form>
      </div>
    </div>
{%- if _inContainer -%}</div>{%- else -%}
  </div>
</section>
{%- endif -%}
